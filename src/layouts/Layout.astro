---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingBanner from '../components/LandingBanner.astro';
import { site } from '../content/site';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.titleDefault, description = site.descriptionDefault } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const ogImage = new URL('/og/default.png', site.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f3778" />
    <meta property="og:image:alt" content="Alexendros.dev — webs claras y útiles" />
  </head>
  <body class="bg-bg text-fg antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <LandingBanner pathname={Astro.url.pathname} />
    <script>
      import '../scripts/reveal.ts';
    </script>
    <Analytics />
    <SpeedInsights />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        alternateName: profile.alternateName,
        jobTitle: profile.role,
        description: profile.summary,
        url: site.url,
        sameAs: [site.social.github, site.social.linkedin],
        email: 'hola@alexendros.dev',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Valencia',
          addressCountry: 'ES'
        }
      })}
    />
  </body>
</html>
