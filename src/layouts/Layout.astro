---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoLatinUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SkipLink from '../components/SkipLink.astro';
import LandingBanner from '../components/LandingBanner.astro';
import CookieBanner from '../components/consent/CookieBanner.tsx';
import { site } from '../content/site';
import { profile } from '../content/profile';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
}
const {
  title = site.titleDefault,
  description = site.descriptionDefault,
  ogImage = '/og/default.png',
  robots
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoLatinUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f8fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1224" media="(prefers-color-scheme: dark)" />
    <meta property="og:image:alt" content="Alexendros.dev — webs claras y útiles" />
    <script is:inline>
      // Gate de JS antes del primer paint: activa las animaciones de
      // entrada del hero y el fundido de imágenes. Sin JS la clase no
      // existe y todo el contenido se muestra directamente.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-bg text-fg antialiased min-h-screen flex flex-col">
    <SkipLink />
    <div data-header-sentinel class="h-px" aria-hidden="true"></div>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <LandingBanner pathname={Astro.url.pathname} />
    <CookieBanner client:idle />
    <script>
      import '../scripts/reveal.ts';
      import '../scripts/header.ts';
      import { initTracking } from '../lib/tracking/loaders';
      initTracking();
    </script>
    {
      /* Analytics solo en despliegues Vercel: en builds locales/CI los scripts
        /_vercel/* no existen y ensucian consola (404) y el score de Best Practices. */
    }
    {__IS_VERCEL__ && <Analytics />}
    {__IS_VERCEL__ && <SpeedInsights />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            name: profile.name,
            alternateName: profile.alternateName,
            jobTitle: profile.role,
            description: profile.summary,
            url: site.url,
            sameAs: [site.social.github, site.social.linkedin],
            email: 'hola@alexendros.dev',
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Valencia',
              addressCountry: 'ES'
            }
          },
          {
            '@type': 'ProfessionalService',
            name: 'Alexendros',
            description: site.descriptionDefault,
            url: site.url,
            email: 'hola@alexendros.dev',
            areaServed: { '@type': 'City', name: 'Valencia' },
            priceRange: '€€',
            sameAs: [site.social.github, site.social.linkedin],
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Valencia',
              addressCountry: 'ES'
            }
          }
        ]
      })}
    />
  </body>
</html>
