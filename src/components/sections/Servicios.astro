---
import { homeServiciosIntro, homeVias } from '../../content/home';
---

<section
  id="servicios"
  class="mx-auto max-w-6xl scroll-mt-nav px-4 py-20"
  aria-labelledby="servicios-heading"
>
  <p class="eyebrow">{homeServiciosIntro.eyebrow}</p>
  <h2 id="servicios-heading" class="max-w-2xl text-3xl font-extrabold tracking-tight">
    {homeServiciosIntro.title}
  </h2>
  <p class="mt-3 max-w-2xl opacity-70">{homeServiciosIntro.lead}</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      homeVias.map((via) => (
        <article class="card card-border bg-base-100 transition-colors hover:border-primary">
          <div class="card-body">
            <span class="badge badge-outline badge-accent">{via.badge}</span>
            <h3 class="card-title text-xl">{via.title}</h3>
            <p class="opacity-80">{via.short}</p>
            <div class="flex flex-wrap gap-2">
              {via.tags.map((tag) => (
                <span class="badge badge-outline">{tag}</span>
              ))}
            </div>
            <p class="text-sm font-semibold text-accent">{via.delivery}</p>
            <div class="card-actions justify-end">
              <a class="btn btn-primary btn-sm" href="#contacto" data-pick-via={via.id}>
                Solicitar esta vía
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
