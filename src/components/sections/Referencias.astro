---
import { projects, workKindLabels } from '../../content/projects';
import { homeReferenciasIntro } from '../../content/home';

const featured = projects.filter((p) => p.featured || true);
---

<section
  id="referencias"
  class="mx-auto max-w-6xl scroll-mt-nav px-4 py-20"
  aria-labelledby="referencias-heading"
>
  <p class="eyebrow">{homeReferenciasIntro.eyebrow}</p>
  <h2 id="referencias-heading" class="text-3xl font-extrabold tracking-tight">
    {homeReferenciasIntro.title}
  </h2>

  <div class="join mt-6" role="group" aria-label="Filtrar proyectos" data-ref-filters>
    {
      homeReferenciasIntro.filters.map((f, i) => (
        <button
          type="button"
          class:list={['btn join-item', i === 0 && 'btn-active']}
          data-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-ref-live></p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-ref-grid>
    {
      featured.map((project) => {
        const filterKey =
          project.workKind === 'encargo'
            ? 'encargo'
            : project.workKind === 'propio'
              ? 'propio'
              : 'all';
        const badge =
          project.workKind === 'propio' && project.productType === 'personal'
            ? 'Web personal'
            : project.workKind === 'propio'
              ? 'Código abierto'
              : workKindLabels[project.workKind];
        return (
          <article
            class="card card-border relative overflow-hidden bg-base-100 transition-colors hover:border-primary"
            data-kind={filterKey}
          >
            <figure
              class="h-32 bg-gradient-to-br from-primary to-secondary/50"
              aria-hidden="true"
            />
            <div class="card-body p-5">
              <span class="badge badge-outline badge-sm">{badge}</span>
              <h3 class="card-title text-base">
                <a
                  class="link link-hover after:absolute after:inset-0"
                  href={`/referencias/${project.slug}`}
                  data-open-dialog={project.slug}
                  aria-haspopup="dialog"
                >
                  {project.title}
                </a>
              </h3>
              <p class="text-sm opacity-70">{project.short}</p>
            </div>
            <template data-project-template={project.slug}>
              <span class="badge badge-outline" data-tpl-badge>
                {badge}
              </span>
              <h3 class="mt-3 text-xl font-bold" id={`dlg-title-${project.slug}`} data-tpl-title>
                {project.title}
              </h3>
              <p class="mt-2 opacity-80" data-tpl-summary>
                {project.summary}
              </p>
              <ul class="mt-4 list-disc space-y-1 pl-5 opacity-80">
                {project.highlights.slice(0, 4).map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <a class="btn btn-primary" href={`/referencias/${project.slug}`} data-tpl-link>
                Ver ficha completa
              </a>
              <button
                class="btn btn-ghost"
                type="button"
                data-tpl-consult
                data-project={project.title}
              >
                Consultar sobre esta obra
              </button>
            </template>
          </article>
        );
      })
    }
  </div>
</section>

<dialog id="ref-dialog" class="modal" aria-labelledby="ref-dialog-title">
  <div class="modal-box">
    <form method="dialog">
      <button
        class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
        aria-label="Cerrar ficha"
        data-dialog-close>✕</button
      >
    </form>
    <div data-dialog-body></div>
    <div class="modal-action" data-dialog-actions></div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="Cerrar">cerrar</button>
  </form>
</dialog>

<script>
  import { initReferencias } from '../../scripts/referencias';
  initReferencias();
</script>
