---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

const EXCLUDED_PATHS = ['/servicios/landing-10-dias', '/contacto', '/contacto/', '/gracias'];
const currentPath = Astro.url.pathname || pathname;

const shouldShow =
  currentPath !== '/proyectos' &&
  !currentPath.startsWith('/proyectos/') &&
  !EXCLUDED_PATHS.some((p) => currentPath === p || currentPath.startsWith(p + '/'));
const CTA_URL = '/contacto?subject=Landing%20en%2010%20d%C3%ADas';
---

{
  shouldShow && (
    <aside
      id="landing-banner"
      class="fixed bottom-0 left-0 right-0 z-40 hidden border-t border-border bg-card/95 backdrop-blur supports-[backdrop-filter]:bg-card/80 transition-transform duration-150 ease-out pb-safe"
      role="region"
      aria-label="Oferta Landing en 10 días"
    >
      <div class="mx-auto max-w-6xl px-6 py-3 flex flex-row items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5 text-sm min-w-0">
          <p class="font-mono text-xs tracking-[0.1em] text-primary">OFERTA · LANDING EN 10 DÍAS</p>
          <p class="truncate">
            <strong class="font-bold">A/B + leads</strong>
            <span class="hidden sm:inline text-muted"> · Desde 990 € · 10 días laborables</span>
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            id="landing-banner-cta"
            href={CTA_URL}
            class="bg-primary text-ink px-4 py-1.5 rounded-lg text-sm font-medium text-center focus-ring transition-opacity hover:opacity-90"
          >
            Quiero mi landing
          </a>
          <button
            id="landing-banner-dismiss"
            type="button"
            class="text-muted hover:text-fg focus-ring rounded-lg p-1.5 transition-colors shrink-0"
            aria-label="Cerrar banner"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </div>
    </aside>
  )
}

<script is:inline>
  (function () {
    const STORAGE_KEY = 'alexendros.banner.landing-10-dias.v1';
    const THRESHOLD = 300;
    let banner = null;
    let dismissBtn = null;
    let ctaBtn = null;
    const htmlEl = document.documentElement;
    let shown = false;
    let dismissed = false;
    let ticking = false;
    function getVa() {
      const va = window.va;
      return va && typeof va.track === 'function' ? va : null;
    }
    function isDismissed() {
      try {
        return localStorage.getItem(STORAGE_KEY) === '1';
      } catch {
        return false;
      }
    }
    function setDismissed() {
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch {}
    }
    function updateBodyPadding() {
      if (!banner) return;
      if (htmlEl.classList.contains('banner-visible')) {
        htmlEl.style.setProperty('--banner-height', banner.offsetHeight + 'px');
      } else {
        htmlEl.style.removeProperty('--banner-height');
      }
    }
    function detachScroll() {
      window.removeEventListener('scroll', onScroll);
    }
    function showBanner() {
      if (shown || dismissed || isDismissed()) return;
      shown = true;
      if (banner) {
        banner.classList.remove('hidden');
        banner.classList.add('visible');
      }
      htmlEl.classList.add('banner-visible');
      updateBodyPadding();
      const va = getVa();
      if (va) va.track('banner_landing10_impression', {});
    }
    function hideBanner() {
      dismissed = true;
      detachScroll();
      if (banner) {
        banner.classList.add('hidden');
        banner.classList.remove('visible');
      }
      htmlEl.classList.remove('banner-visible');
      updateBodyPadding();
      setDismissed();
      const va = getVa();
      if (va) va.track('banner_landing10_dismiss', {});
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        if (window.scrollY >= THRESHOLD) {
          detachScroll();
          showBanner();
        }
      });
    }
    function init() {
      banner = document.getElementById('landing-banner');
      if (!banner) return;
      if (isDismissed()) return;
      dismissBtn = document.getElementById('landing-banner-dismiss');
      ctaBtn = document.getElementById('landing-banner-cta');
      if (ctaBtn) {
        ctaBtn.addEventListener('click', function () {
          const va = getVa();
          if (va) va.track('banner_landing10_cta_click', {});
        });
      }
      if (dismissBtn) dismissBtn.addEventListener('click', hideBanner);
      window.addEventListener('resize', updateBodyPadding);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        banner.classList.add('reduce-motion');
      }
      if (window.scrollY >= THRESHOLD) {
        showBanner();
      } else {
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
