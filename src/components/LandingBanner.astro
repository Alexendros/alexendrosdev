---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

const EXCLUDED_PATHS = ['/servicios/landing-10-dias', '/contacto', '/contacto/', '/gracias'];

const shouldShow = !EXCLUDED_PATHS.some((p) => pathname === p || pathname.startsWith(p + '/'));
const CTA_URL = '/contacto?subject=Landing%20en%2010%20d%C3%ADas';
---

{
  shouldShow && (
    <aside
      id="landing-banner"
      class="fixed bottom-0 left-0 right-0 z-40 hidden border-t border-border bg-card/95 backdrop-blur supports-[backdrop-filter]:bg-card/80 transition-transform duration-150 ease-out pb-safe"
      role="region"
      aria-label="Oferta Landing en 10 días"
      data-va-track="banner_landing10"
    >
      <div class="mx-auto max-w-6xl px-6 py-4 md:py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex flex-col md:flex-row md:items-center gap-3 text-sm">
          <strong class="font-bold">Landing en 10 días</strong>
          <span class="text-muted hidden md:inline">·</span>
          <span class="text-muted">A/B + leads · Desde 990 € · 10 días laborables</span>
        </div>
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3 w-full md:w-auto">
          <a
            id="landing-banner-cta"
            href={CTA_URL}
            class="bg-primary text-ink px-6 py-3 rounded-full font-medium text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-opacity hover:opacity-90"
          >
            Quiero mi landing
          </a>
          <button
            id="landing-banner-dismiss"
            type="button"
            class="text-muted hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full p-2 md:p-1.5 transition-colors shrink-0"
            aria-label="Cerrar banner"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </div>
    </aside>
  )
}

<script is:inline src="/scripts/landing-banner.js"></script>
