---
// Insignia de estado: punto (.badge-dot, pulso suave definido en
// global.css, pausado con reduced-motion) + texto.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 text-xs font-mono border border-border rounded-lg px-3 py-1 text-muted',
    className
  ]}
>
  <span class="badge-dot" aria-hidden="true"></span>
  <span><slot /></span>
</span>
