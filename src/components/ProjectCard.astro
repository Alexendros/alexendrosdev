---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
  /** h2 en indices (bajo h1), h3 en home (bajo h2 de seccion) */
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<a
  href={`/proyectos/${project.slug}`}
  class="border border-border rounded-lg overflow-hidden hover:border-primarySoft transition bg-card group flex flex-col focus-ring"
>
  <Image
    src={project.cover}
    alt={`Captura de ${project.title}`}
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="w-full h-40 object-cover border-b border-border"
    loading="lazy"
  />
  <div class="p-6 flex-1 flex flex-col">
    <Heading class="font-bold text-base mt-1 group-hover:text-primary transition"
      >{project.title}</Heading
    >
    <p class="mt-2 text-sm text-muted">{project.short}</p>
    <div class="mt-auto pt-4 text-sm font-medium">Ver caso →</div>
  </div>
</a>
