---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  href={`/proyectos/${project.slug}`}
  class="border border-border rounded-2xl overflow-hidden hover:border-primary/40 transition bg-card group flex flex-col focus-ring"
>
  <Image
    src={project.cover}
    alt=""
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="w-full h-40 object-cover border-b border-border bp-duo"
    loading="lazy"
  />
  <div class="p-6 flex-1 flex flex-col">
    <h2 class="font-bold text-base group-hover:text-primary transition">{project.title}</h2>
    <p class="mt-2 text-sm text-muted">{project.short}</p>
    <div class="mt-auto pt-4 text-sm font-medium">Ver caso →</div>
  </div>
</a>
