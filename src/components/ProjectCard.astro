---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  href={`/proyectos/${project.slug}`}
  class="relative border border-border rounded-none overflow-hidden hover:border-primarySoft transition bg-card group flex flex-col focus-ring"
>
  <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-br" aria-hidden="true"></span>
  <Image
    src={project.cover}
    alt=""
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="w-full h-40 object-cover border-b border-border bp-duo"
    loading="lazy"
  />
  <div class="p-6 flex-1 flex flex-col">
    <p class="font-mono text-[11px] tracking-[0.2em] text-muted">
      CASO · {project.slug.toUpperCase()}
    </p>
    <h2 class="font-bold text-base mt-1 group-hover:text-primary transition">{project.title}</h2>
    <p class="mt-2 text-sm text-muted">{project.short}</p>
    <div class="mt-auto pt-4 text-sm font-medium">Ver caso →</div>
  </div>
</a>
