---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
  /** h2 en indices (bajo h1), h3 en home (bajo h2 de seccion) */
  headingLevel?: 'h2' | 'h3';
  /** Carga inmediata (LCP) para la primera tarjeta visible del indice */
  priority?: boolean;
}
const { project, headingLevel = 'h2', priority = false } = Astro.props;
const Heading = headingLevel;
---

<article
  class="card-lift group relative border border-border rounded-lg overflow-hidden hover:border-primarySoft bg-card flex flex-col h-full focus-within:outline focus-within:outline-2 focus-within:outline-primary focus-within:outline-offset-2"
>
  <Image
    src={project.cover}
    alt={project.coverAlt}
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="card-cover card-img w-full aspect-[16/10] object-cover border-b border-border"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    onload="this.classList.add('is-loaded')"
  />
  <div class="p-6 flex-1 flex flex-col">
    <Heading class="font-bold text-base mt-1 group-hover:text-primary transition-colors">
      <a href={`/proyectos/${project.slug}`} class="rounded after:absolute after:inset-0">
        {project.title}
      </a>
    </Heading>
    <p class="mt-2 text-sm text-muted">{project.short}</p>
    {
      project.metrics && project.metrics.length > 0 && (
        <p class="mt-2 text-xs font-medium text-brand">
          {project.metrics[0].value} · {project.metrics[0].label}
        </p>
      )
    }
    <div class="mt-auto pt-4 text-sm font-medium" aria-hidden="true">Ver caso →</div>
  </div>
</article>
