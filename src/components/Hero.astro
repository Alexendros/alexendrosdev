---
import BlueprintMotif from './BlueprintMotif.astro';
import Button from './Button.astro';
import Link from './Link.astro';

const phrases = [
  'emprendimientos personales novedosos de alto impacto social y reputación profesional',
  'sociedades empresariales con sólidas estructuras productivas',
  'historia y obra de seres humanos con valores ejemplares'
] as const;
---

<section
  class="relative mx-auto max-w-3xl overflow-hidden px-[var(--gutter)] py-16 md:py-24"
  data-hero
>
  <div
    class="pointer-events-none absolute -right-16 top-4 h-56 w-auto overflow-hidden md:-right-20 md:top-8 md:h-96"
    aria-hidden="true"
  >
    <BlueprintMotif class="h-full w-auto aspect-[4/3] text-brand-line" />
  </div>

  <div data-hero-item data-hero-lcp style="--i:0">
    <h1 class="bp-h1 text-4xl md:text-5xl font-bold leading-[1.05] tracking-tight max-w-3xl">
      Aquí se crean productos digitales que son reflejo de
      <span class="sr-only">
        {` ${phrases[0]}, ${phrases[1]} y ${phrases[2]}`}
      </span>
      <span class="hero-slot">
        <span class="hero-slot-measure" aria-hidden="true">
          {phrases.map((phrase) => <span class="hero-slot-measure-line">{phrase}</span>)}
        </span>
        <span class="hero-slot-stage" aria-hidden="true">
          {
            phrases.map((phrase, i) => (
              <span class="hero-slot-item bp-h1-draft" data-i={i}>
                {phrase}
              </span>
            ))
          }
        </span>
      </span>
    </h1>
  </div>

  <p class="mt-6 text-lg text-muted max-w-2xl" data-hero-item style="--i:1">
    Diseño y publico webs y portales para profesionales y negocios, con precio cerrado por escrito,
    plazos de entrega concretos y garantía sobre lo acordado. Puedes empezar con un informe
    comercial, resolver una duda en una sesión profesional o encargar un portal de inicio que crece
    por módulos. Cada propuesta se cierra antes de empezar; no hay sorpresas a mitad de camino.
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3" data-hero-item style="--i:2">
    <Button href="/servicios">Ver servicios</Button>
    <Link href="/contacto" variant="inline" class="text-muted">Contactar</Link>
  </div>
</section>
