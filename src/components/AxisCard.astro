---
import type { Eje } from '../content/ejes';

interface Props {
  eje: Eje;
}
const { eje } = Astro.props;
---

<div class="relative border border-border rounded-none p-6 bg-card">
  <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-br" aria-hidden="true"></span>
  <h3 class="font-bold text-lg">{eje.title}</h3>
  <p class="mt-2 text-sm text-muted">{eje.description}</p>
</div>
