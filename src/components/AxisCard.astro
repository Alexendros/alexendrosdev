---
import type { Eje } from '../content/ejes';

interface Props {
  eje: Eje;
}
const { eje } = Astro.props;
---

<div class="card-lift border border-border rounded-lg p-6 bg-card h-full">
  <h3 class="font-bold text-lg">{eje.title}</h3>
  <p class="mt-2 text-sm text-muted">{eje.description}</p>
</div>
