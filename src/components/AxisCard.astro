---
import type { Eje } from '../content/ejes';

interface Props {
  eje: Eje;
}
const { eje } = Astro.props;
---

<div class="border border-border rounded-2xl p-6 bg-card">
  <p class="font-mono text-xs tracking-[0.2em] text-primary">EJE {eje.index}</p>
  <h3 class="font-bold text-lg mt-2">{eje.title}</h3>
  <p class="mt-2 text-sm text-muted">{eje.description}</p>
</div>
