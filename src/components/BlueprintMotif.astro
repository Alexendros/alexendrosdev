---
// Motivo esquemático cianotipo: linework decorativo estilo plano técnico
// (tubería, círculos de registro, escuadra con sombreado). Todo aria-hidden,
// sin animación; el trazado no se anima para respetar reduced-motion.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 320 240"
  fill="none"
  stroke="#ffffff"
  stroke-opacity="0.14"
  stroke-width="1"
  aria-hidden="true"
  class={className}
>
  <g class="bp-motif-fade">
    <circle cx="70" cy="70" r="44"></circle>
    <circle cx="70" cy="70" r="30"></circle>
    <circle cx="70" cy="70" r="6"></circle>
    <path d="M70 114 V 200 H 250"></path>
    <path d="M114 70 H 200 V 160"></path>
    <circle cx="200" cy="160" r="18"></circle>
    <circle cx="250" cy="200" r="10"></circle>
    <rect x="180" y="30" width="110" height="60"></rect>
    <path
      d="M180 30 L290 90 M180 44 L290 104 M180 58 L290 118 M180 72 L276 118 M180 86 L248 118 M180 100 L220 118"
      stroke-opacity="0.1"></path>
    <path d="M14 70 H 26 M70 14 V 26 M296 200 H 308 M250 216 V 228" stroke-opacity="0.2"></path>
    <circle cx="250" cy="60" r="3" stroke-opacity="0.2"></circle>
    <circle cx="40" cy="190" r="3" stroke-opacity="0.2"></circle>
  </g>
</svg>
<style>
  @media (min-width: 768px) {
    .bp-motif-fade {
      opacity: 0.35;
    }
  }
</style>
