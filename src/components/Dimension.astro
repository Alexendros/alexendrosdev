---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="hidden md:block" aria-hidden="true">
  <div class="flex items-center gap-3 font-mono text-xs tracking-[0.1em] text-muted">
    <span class="h-3 w-px bg-border"></span>
    <span class="h-px flex-1 bg-border"></span>
    <span>{label}</span>
    <span class="h-px flex-1 bg-border"></span>
    <span class="h-3 w-px bg-border"></span>
  </div>
  <div class="mx-10 mt-1 h-px bg-border opacity-50"></div>
</div>
