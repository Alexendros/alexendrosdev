---
import { site } from '../content/site';
import Link from './Link.astro';
---

<footer class="border-t border-border mt-0 cv-auto">
  <div class="h-[3px] bp-hatch opacity-60" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-24 grid md:grid-cols-2 gap-10 text-sm">
    <div>
      <div class="font-mono font-bold">Alexendros<span class="text-primary">.dev</span></div>
      <p class="text-muted mt-2 max-w-xs">
        Webs claras y útiles para profesionales y pequeños negocios. Valencia — remoto.
      </p>
      <div class="mt-4 text-muted">
        <Link href={site.social.email} variant="nav">hola@alexendros.dev</Link>
        <div class="mt-2 flex gap-3">
          <Link href={site.social.github} variant="nav" target="_blank" rel="noopener noreferrer"
            >GitHub</Link
          >
          <Link href={site.social.linkedin} variant="nav" target="_blank" rel="noopener noreferrer"
            >LinkedIn</Link
          >
        </div>
        <div class="mt-4 text-xs">Sin cookies de seguimiento. Privacidad respetada.</div>
      </div>
    </div>
    <div class="flex gap-10">
      <div>
        <div class="font-medium mb-2">Navegación</div>
        <ul class="space-y-1 text-muted">
          {
            site.nav.map((i) => (
              <li>
                <Link href={i.href} variant="nav">
                  {i.label}
                </Link>
              </li>
            ))
          }
          <li>
            <Link href="/contacto" variant="nav">Contacto</Link>
          </li>
        </ul>
      </div>
      <div>
        <div class="font-medium mb-2">Legal</div>
        <ul class="space-y-1 text-muted">
          {
            site.footerNav.map((i) => (
              <li>
                <Link href={i.href} variant="nav">
                  {i.label}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
