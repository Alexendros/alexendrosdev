---
// Wrapper de compatibilidad: delega en SectionHeader (misma API que el
// FigureHead original). Las páginas nuevas deberían usar SectionHeader
// directamente; este archivo evita churn en las rutas existentes.
import SectionHeader from './SectionHeader.astro';

interface Props {
  index: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkText?: string;
  align?: 'start' | 'center';
}
const { index, title, description, linkHref, linkText, align } = Astro.props;
---

<SectionHeader
  index={index}
  title={title}
  description={description}
  linkHref={linkHref}
  linkText={linkText}
  align={align}
/>
