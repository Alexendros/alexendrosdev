---
interface Props {
  index: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkText?: string;
  align?: 'start' | 'center';
}
const { index, title, description, linkHref, linkText, align = 'start' } = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'flex gap-4',
    centered ? 'flex-col items-center text-center' : 'justify-between items-end'
  ]}
>
  <div class:list={[centered && 'flex flex-col items-center']}>
    <p class="font-mono text-xs tracking-[0.1em] text-primary">FIG. {index}</p>
    <h2 class="text-2xl font-bold mt-2">{title}</h2>
    {
      description && (
        <p class:list={['text-sm text-muted mt-2 max-w-2xl', centered && 'mx-auto']}>
          {description}
        </p>
      )
    }
  </div>
  {
    linkHref && linkText && (
      <a href={linkHref} class="text-sm text-muted hover:text-fg focus-ring rounded shrink-0">
        {linkText} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
