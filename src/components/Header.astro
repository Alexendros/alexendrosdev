---
import { site } from '../content/site';

const contactHref = '/#contacto';
---

<header
  id="site-header"
  class="navbar sticky top-0 z-50 border-b border-base-300 bg-base-100 px-3 lg:px-8"
>
  <div class="navbar-start">
    <details class="dropdown lg:hidden" id="mm">
      <summary class="btn btn-ghost btn-square" aria-label="Abrir menú">☰</summary>
      <ul
        class="menu dropdown-content z-10 mt-3 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow"
      >
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li class="mt-2">
          <a class="btn btn-primary" href={contactHref}>Solicitar propuesta</a>
        </li>
      </ul>
    </details>
    <a class="btn btn-ghost text-lg font-extrabold tracking-tight" href="/#top">
      Alexendros<span class="text-sm font-normal opacity-60">.dev</span>
    </a>
  </div>
  <nav class="navbar-center hidden lg:flex" aria-label="Principal">
    <ul class="menu menu-horizontal gap-1">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="navbar-end gap-1">
    {/* theme-controller oculto: el botón cicla y sincroniza el input. */}
    <input type="checkbox" class="theme-controller hidden" value="alexdark" data-theme-input />
    <button
      type="button"
      class="btn btn-ghost btn-circle js-only"
      data-theme-toggle
      aria-label="Tema: sistema. Pulsar para cambiar"
    >
      <span aria-hidden="true">◐</span>
    </button>
    <a class="btn btn-primary hidden sm:inline-flex" href={contactHref}>Solicitar propuesta</a>
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/themeToggle';
  initThemeToggle();
</script>
