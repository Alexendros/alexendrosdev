---
import { site } from '../content/site';
import Link from './Link.astro';
import Button from './Button.astro';
const path = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-50 backdrop-blur border-b border-border bg-bg/80">
  <div class="mx-auto max-w-6xl px-6 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-mono font-bold tracking-tight shrink-0 focus-ring rounded"
      >Alexendros<span class="text-primary">.dev</span></a
    >
    <nav
      class="site-nav hidden md:flex flex-wrap justify-end gap-x-4 gap-y-1 text-sm"
      aria-label="Principal"
    >
      {
        site.nav.map((i) => {
          const current = path.startsWith(i.href);
          return (
            <Link href={i.href} variant="nav" current={current} class="text-muted">
              {i.label}
            </Link>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-2 shrink-0">
      <Button href="/contacto" size="sm">Cuéntame</Button>
      <button
        type="button"
        data-menu-button
        class="md:hidden inline-flex items-center justify-center w-10 h-10 border border-border hover:border-primary hover:text-primary focus-ring"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <svg
          id="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg
          id="menu-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <nav
    data-mobile-nav
    id="mobile-nav"
    class="md:hidden border-t border-border"
    aria-label="Principal"
    hidden
  >
    <ul class="px-6 py-3 flex flex-col gap-1 text-sm">
      {
        site.nav.map((i) => (
          <li>
            <Link
              href={i.href}
              variant="nav"
              current={path.startsWith(i.href)}
              class="block py-2 text-muted"
            >
              {i.label}
            </Link>
          </li>
        ))
      }
      <li>
        <Link
          href="/contacto"
          variant="nav"
          current={path.startsWith('/contacto')}
          class="block py-2 text-muted"
        >
          Cuéntame
        </Link>
      </li>
    </ul>
  </nav>
  <span class="reading-progress" aria-hidden="true"></span>
</header>

<script>
  function initMobileNav(): void {
    const menuButton = document.querySelector('[data-menu-button]');
    const mobileNav = document.querySelector('[data-mobile-nav]');
    if (!(menuButton instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const menuLinks = Array.from(mobileNav.querySelectorAll('a'));
    const isMenuOpen = (): boolean => menuButton.getAttribute('aria-expanded') === 'true';
    const setMenuOpen = (open: boolean): void => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      if (open) {
        mobileNav.removeAttribute('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        menuLinks[0]?.focus();
      } else {
        mobileNav.setAttribute('hidden', '');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    };
    menuButton.addEventListener('click', () => setMenuOpen(!isMenuOpen()));
    mobileNav.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        setMenuOpen(false);
        menuButton.focus();
      }
    });
    menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav, { once: true });
  } else {
    initMobileNav();
  }
</script>
