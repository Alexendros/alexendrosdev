---
interface Props {
  service: import('../content/services').Service;
}
const { service } = Astro.props;
---

<a
  href={`/servicios/${service.slug}`}
  class="group border border-border rounded-2xl p-6 hover:border-primarySoft transition bg-card flex flex-col focus-ring"
>
  <h2 class="font-bold text-lg leading-tight group-hover:text-primary transition">
    {service.title}
  </h2>
  <p class="mt-3 text-sm text-muted">{service.short}</p>
  <p class="mt-4 text-sm text-muted">{service.pricingFrom}</p>
  <div class="mt-auto pt-4 text-sm font-medium">Ver qué incluye →</div>
</a>
