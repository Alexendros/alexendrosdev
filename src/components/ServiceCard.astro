---
interface Props {
  service: import('../content/services').Service;
  /** h2 en indices (bajo h1), h3 en home (bajo h2 de seccion) */
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article
  class="card-lift group relative border border-border rounded-lg p-6 hover:border-primarySoft bg-card flex flex-col h-full focus-within:outline-2 focus-within:outline-primary focus-within:outline-offset-2"
>
  <Heading class="font-bold text-lg leading-tight mt-1 group-hover:text-primary transition-colors">
    <a href={`/servicios/${service.slug}`} class="rounded after:absolute after:inset-0">
      {service.title}
    </a>
  </Heading>
  <p class="mt-3 text-sm text-muted">{service.short}</p>
  <p class="mt-4 text-sm text-muted">{service.pricingFrom}</p>
  <div class="mt-auto pt-4 text-sm font-medium" aria-hidden="true">Ver qué incluye →</div>
</article>
