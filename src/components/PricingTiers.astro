---
interface Props {
  tiers: import('../content/services').Service['tiers'];
}
const { tiers } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-3">
  {
    tiers.map((tier) => (
      <article
        class:list={[
          'card-lift relative flex h-full flex-col rounded-lg border p-6 bg-card',
          tier.highlight ? 'border-primary bg-primaryGhost' : 'border-border'
        ]}
      >
        {tier.highlight && (
          <span class="mb-3 inline-flex w-fit items-center rounded-full bg-primary px-3 py-1 text-xs font-medium text-ink">
            Recomendado
          </span>
        )}
        <h3 class="text-lg font-bold">{tier.name}</h3>
        <p class="mt-1 text-sm text-muted">{tier.price}</p>
        <ul class="mt-4 space-y-2 text-sm text-muted">
          {tier.features.map((feature) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-brand">
                ✓
              </span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
