---
import type { Service } from '../content/services';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<div
  data-service-slider
  role="region"
  aria-roledescription="carrusel"
  aria-label="Ofertas de servicios"
  class="relative border border-border bg-card p-6 md:p-10"
>
  <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-br" aria-hidden="true"></span>

  <div class="grid">
    {
      services.map((service) => (
        <article data-slide class="col-start-1 row-start-1">
          <p class="font-mono text-[11px] tracking-[0.2em] text-muted">
            SERVICIO · {service.slug.toUpperCase()}
          </p>
          <h3 class="mt-2 text-2xl md:text-3xl font-bold leading-tight max-w-2xl">
            {service.title}
          </h3>
          <p class="mt-3 text-muted max-w-2xl">{service.short}</p>
          <p class="mt-4 font-mono text-xs tracking-[0.15em] text-primary">
            {service.pricingFrom.toUpperCase()} · {service.timeline.toUpperCase()}
          </p>
          <a
            href={`/servicios/${service.slug}`}
            class="mt-6 inline-block text-sm font-medium underline underline-offset-4 hover:text-primary focus-ring rounded"
          >
            Ver qué incluye →
          </a>
        </article>
      ))
    }
  </div>

  <div class="mt-8 flex items-center justify-between border-t border-border pt-4">
    <div class="flex items-center gap-3">
      <button
        type="button"
        data-prev
        aria-label="Oferta anterior"
        class="font-mono border border-border w-10 h-10 hover:border-primary hover:text-primary transition focus-ring"
      >
        ←
      </button>
      <button
        type="button"
        data-next
        aria-label="Oferta siguiente"
        class="font-mono border border-border w-10 h-10 hover:border-primary hover:text-primary transition focus-ring"
      >
        →
      </button>
    </div>
    <p data-counter aria-live="polite" class="font-mono text-xs tracking-[0.2em] text-muted">
      01/{String(services.length).padStart(2, '0')}
    </p>
    <div class="flex items-center gap-2">
      {
        services.map((service, i) => (
          <button
            type="button"
            data-dot
            aria-label={`Ir a la oferta: ${service.title}`}
            class={`w-2.5 h-2.5 transition focus-ring ${i === 0 ? 'bg-primary' : 'bg-border hover:bg-muted'}`}
          />
        ))
      }
    </div>
  </div>
</div>

<script>
  import '../scripts/service-slider.ts';
</script>
