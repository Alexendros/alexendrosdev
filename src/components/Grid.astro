---
// Rejilla con gap desde la escala de espaciado (--space-*). Las columnas
// se declaran con clases responsive habituales vía `class`
// (p. ej. "sm:grid-cols-2 lg:grid-cols-4"). Admite atributos extra
// (data-*, aria-*) vía rest spread.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'ul' | 'ol';
  gap?: string;
}
const { as: Tag = 'div', gap = '6', class: className = '', ...attrs } = Astro.props;
---

<Tag {...attrs} class:list={['grid', className]} style={`gap: var(--space-${gap})`}>
  <slot />
</Tag>
