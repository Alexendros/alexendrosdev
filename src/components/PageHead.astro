---
// Cabecera de página cianotipo: cajetín mono encima del título y regla
// hairline debajo. Unifica las portadas de sección (servicios, casos,
// contacto, proceso, legales) con el lenguaje de plano.
import Eyebrow from './Eyebrow.astro';

interface Props {
  kicker: string;
  title: string;
  description?: string;
}
const { kicker, title, description } = Astro.props;
---

<div>
  <Eyebrow>{kicker}</Eyebrow>
  <h1 class="mt-2 text-4xl font-bold max-w-3xl">{title}</h1>
  <div class="mt-4 h-px bg-border" aria-hidden="true"></div>
  {description && <p class="text-muted mt-3 max-w-2xl">{description}</p>}
</div>
