---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
}
const { kicker, title, description } = Astro.props;
---

<div>
  {kicker ? <p class="eyebrow">{kicker}</p> : null}
  <h1
    class:list={[kicker ? 'mt-2' : null, 'break-words text-3xl font-bold text-balance max-w-3xl']}
  >
    {title}
  </h1>
  <div class="mt-4 h-px bg-base-300" aria-hidden="true"></div>
  {description && <p class="mt-3 max-w-2xl opacity-70">{description}</p>}
</div>
