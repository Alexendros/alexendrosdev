---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import Grid from '../components/Grid.astro';
import { profile } from '../content/profile';
---

<Layout title={profile.pageTitle} description={profile.pageDescription}>
  <Container class="py-16 md:py-24">
    <p class="text-sm text-muted">{profile.metaLine}</p>
    <h1 class="mt-3 text-step-3 break-words font-bold max-w-3xl text-balance">
      {profile.headline}
    </h1>
    <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    <p class="mt-3 text-lg text-muted max-w-2xl">{profile.role}</p>
    <p class="mt-6 max-w-2xl">{profile.summary}</p>
    <p class="mt-4 max-w-2xl text-muted">{profile.title}</p>

    <section class="mt-16" aria-labelledby="why-heading">
      <h2 id="why-heading" class="text-2xl font-bold">Ventajas del encargo</h2>
      <Grid gap="6" class="mt-8 md:grid-cols-3">
        {
          profile.workWithMe.map((item) => (
            <article class="border border-border rounded-lg p-5 bg-card">
              <h3 class="font-bold text-lg">{item.title}</h3>
              <p class="mt-3 text-sm text-muted">{item.body}</p>
            </article>
          ))
        }
      </Grid>
    </section>

    <section class="mt-16" aria-labelledby="trajectory-heading">
      <h2 id="trajectory-heading" class="text-2xl font-bold">Trayectoria</h2>
      <p class="mt-3 max-w-2xl text-muted">{profile.trajectory}</p>
      <p class="mt-4">
        <Link href="/referencias" variant="arrow">Ver referencias</Link>
      </p>
    </section>

    <section class="mt-16" aria-labelledby="trust-heading">
      <h2 id="trust-heading" class="text-2xl font-bold">Modalidad de colaboración</h2>
      <ul class="mt-6 list-disc pl-5 text-sm text-muted space-y-2 max-w-2xl">
        {profile.trustBar.map((item) => <li>{item}</li>)}
      </ul>
      <div class="mt-8">
        <Button href="/contacto?motivo=propuestaComercial&origen=home">Solicitar propuesta</Button>
      </div>
    </section>
  </Container>
</Layout>
