---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Servicios from '../components/sections/Servicios.astro';
import Referencias from '../components/sections/Referencias.astro';
import Metodo from '../components/sections/Metodo.astro';
import Contacto from '../components/sections/Contacto.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<Layout ogImage="/og/home.png" ogImageAlt="Alexendros.dev — auditoría, diseño y construcción">
  <Hero />
  <Servicios />
  <Referencias />
  <Metodo />
  <Contacto turnstileSiteKey={turnstileSiteKey} />
</Layout>
