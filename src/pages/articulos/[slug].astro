---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import Button from '../../components/Button.astro';
import { articles } from '../../content/articles';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — Alexendros`} description={article.description}>
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <p class="text-xs text-muted">
      <Link href="/" variant="nav">Inicio</Link> / Artículo
    </p>
    <h1 class="mt-3 text-step-3 break-words font-bold max-w-3xl text-balance">{article.title}</h1>
    <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    <p class="mt-3 text-muted max-w-2xl">{article.description}</p>
    <p class="mt-2 text-xs font-mono text-muted">{article.published}</p>
    <div class="mt-10 space-y-5 text-sm text-muted max-w-2xl">
      {article.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="mt-12 flex flex-wrap items-center gap-4">
      <Button href="/contacto?motivo=propuestaComercial&origen=home">Solicitar propuesta</Button>
      <Link href="/servicios" variant="inline">Ver servicios</Link>
    </div>
  </div>
</Layout>
