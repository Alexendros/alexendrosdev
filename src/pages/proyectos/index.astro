---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Container from '../../components/Container.astro';
import Grid from '../../components/Grid.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../content/projects';
---

<Layout
  title="Proyectos — Alexendros"
  description="Proyectos reales: el problema, lo que se hizo y qué cambió. Detalles técnicos disponibles en cada ficha."
>
  <Container class="py-16 md:py-24">
    <PageHead
      kicker="ÍNDICE · PROYECTOS"
      title="Proyectos reales"
      description="En cada proyecto verás el punto de partida, lo que se hizo y qué cambió."
    />
    <Grid gap="6" class="mt-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => <ProjectCard project={p} priority={i === 0} />)}
    </Grid>
  </Container>
</Layout>
