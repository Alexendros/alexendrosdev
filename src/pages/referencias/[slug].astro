---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Link from '../../components/Link.astro';
import { Image } from 'astro:assets';
import {
  availabilityCtaLabels,
  productTypeLabels,
  projects,
  workKindLabels
} from '../../content/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const statusLabel =
  project.slug === 'zedazo'
    ? 'Herramienta propia, de código abierto'
    : `${productTypeLabels[project.productType]} · ${workKindLabels[project.workKind]}`;
const changedItems =
  project.results && project.results.length > 0 ? project.results : project.highlights;
---

<Layout
  title={`${project.title} — Alexendros`}
  description={project.short}
  ogImage={`/og/proyectos/${project.slug}.png`}
  ogImageAlt={`Ficha de ${project.title}`}
>
  <div class="mx-auto max-w-3xl px-4 pt-12 pb-16">
    <div class="text-xs text-muted">
      <Link href="/referencias" variant="nav">← Todas las referencias</Link>
    </div>
    <h1 class="mt-3 text-step-3 break-words font-bold text-balance">{project.title}</h1>
    <p class="mt-3 text-muted text-pretty">{project.summary}</p>
    <p class="mt-3 text-sm font-mono text-muted text-pretty break-words">{statusLabel}</p>
    <div class="mt-4 h-px bg-border" aria-hidden="true"></div>
    <figure class="mt-6 overflow-hidden rounded-lg border border-border">
      <Image
        src={project.cover}
        alt={project.coverAlt}
        widths={[800, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        class="block h-auto w-full max-w-full"
        loading="eager"
        decoding="async"
      />
    </figure>

    {
      project.metrics && project.metrics.length > 0 && (
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {project.metrics.map((m) => (
            <div class="border border-border rounded-lg p-4 bg-card">
              <p class="text-2xl font-bold text-fg">{m.value}</p>
              <p class="mt-1 text-xs text-muted">{m.label}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      project.testimonial && (
        <figure class="mt-6 border-l-2 border-primary pl-5">
          <blockquote class="text-sm italic text-fg">«{project.testimonial.quote}»</blockquote>
          <figcaption class="mt-2 text-xs text-muted">
            {project.testimonial.author}
            {project.testimonial.role && <span> · {project.testimonial.role}</span>}
          </figcaption>
        </figure>
      )
    }

    <div class="mt-8" data-reveal></div>

    <div class="mt-10 grid md:grid-cols-[1.2fr_0.8fr] gap-10" data-reveal>
      <div class="min-w-0 space-y-8 text-sm">
        <div>
          <h2 class="font-bold">Punto de partida</h2>
          <p class="text-muted mt-1 text-pretty">{project.context}</p>
        </div>
        <div>
          <h2 class="font-bold">Qué hice</h2>
          <p class="text-muted mt-1 text-pretty">{project.solution}</p>
        </div>
        <div>
          <h2 class="font-bold">Qué cambió</h2>
          <ul class="list-disc pl-5 text-muted space-y-1 mt-1">
            {changedItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="min-w-0 space-y-6 cv-auto">
        <details class="border border-border rounded-lg p-5 bg-card" open>
          <summary class="font-bold text-sm cursor-pointer focus-ring rounded"
            >Detalles técnicos</summary
          >
          <div class="mt-3 space-y-4 text-xs text-muted">
            <ul class="list-disc pl-5 space-y-1">
              {project.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <ul class="list-disc pl-5 space-y-1">
              {project.responsibilities.map((r) => <li>{r}</li>)}
            </ul>
            <div class="space-y-2">
              {project.technologies.map((t) => <p>{t}</p>)}
            </div>
          </div>
        </details>
        <div class="border border-border rounded-lg p-5 bg-card">
          <h2 class="font-bold text-sm">Enlaces</h2>
          <div class="mt-2 flex gap-3 text-xs">
            {
              project.links.prod && (
                <Link
                  href={project.links.prod}
                  variant="inline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver en vivo
                </Link>
              )
            }
            {
              project.links.github && (
                <Link
                  href={project.links.github}
                  variant="inline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Código
                </Link>
              )
            }
          </div>
        </div>
        <Button
          href={`/contacto?motivo=informacionCliente&origen=referencias&proyecto=${encodeURIComponent(project.slug)}`}
          class="w-full"
        >
          {availabilityCtaLabels[project.availability]}
        </Button>
      </div>
    </div>
  </div>
</Layout>
