---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DetailIsland from '../../components/DetailIsland.astro';
import { availabilityCtaLabels, productTypeLabels, projects } from '../../content/projects';

const detailItems = projects.map((p) => ({
  slug: p.slug,
  path: `/referencias/${p.slug}`,
  title: p.title,
  short: p.short,
  description: p.summary,
  meta: productTypeLabels[p.productType],
  ctaLabel: availabilityCtaLabels[p.availability],
  ctaHref: `/contacto?motivo=informacionCliente&proyecto=${p.slug}&origen=referencias`
}));
---

<Layout
  title="Proyectos realizados por encargo — Alexendros"
  description="Proyectos realizados por encargo con el alcance acordado en cada caso."
  ogImage="/og/proyectos.png"
  ogImageAlt="Proyectos realizados por encargo"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <header>
      <h1 class="text-step-3 break-words font-bold max-w-3xl text-balance">
        Proyectos realizados por encargo.
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    </header>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div>
            <ProjectCard project={p} priority={i === 0} />
          </div>
        ))
      }
    </div>
    <DetailIsland basePath="/referencias" items={detailItems} />
  </div>
</Layout>
