---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
---

<Layout title="Página no encontrada — Alexendros" description="Esta página no existe.">
  <div class="mx-auto max-w-3xl px-4 relative py-16 md:py-24 overflow-hidden">
    <PageHead
      title="Esta página no existe"
      description="La página que buscas se ha movido o ya no existe. Estas son las páginas disponibles."
    />
    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      <Button href="/">Volver al inicio</Button>
      <Link href="/#contacto" variant="inline" class="text-muted">Contacto</Link>
    </div>
  </div>
</Layout>
