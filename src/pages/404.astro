---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
---

<Layout title="Hoja no encontrada — Alexendros" description="Esta hoja del plano no existe.">
  <div class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <PageHead
      kicker="HOJA · NO ENCONTRADA"
      title="Esta hoja del plano no existe"
      description="La página que buscas se ha movido o nunca se dibujó. Estas son las hojas disponibles."
    />
    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3">
      <a href="/" class="bg-primary text-ink px-6 py-3 rounded-full font-medium focus-ring"
        >Volver al plano general</a
      >
      <a href="/contacto" class="underline text-muted hover:text-fg focus-ring rounded"
        >Cuéntame qué buscabas</a
      >
    </div>
  </div>
</Layout>
