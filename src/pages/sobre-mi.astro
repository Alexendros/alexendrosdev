---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import Grid from '../components/Grid.astro';
import { profile } from '../content/profile';
import headshot from '../assets/headshot-alexendros.webp';
---

<Layout title={profile.pageTitle} description={profile.pageDescription}>
  <Container size="narrow" class="py-16 md:py-24">
    <div class="grid gap-8 md:grid-cols-[1fr_300px] md:items-start">
      <div>
        <Eyebrow>SOBRE MÍ</Eyebrow>
        <h1 class="mt-2 text-4xl font-bold max-w-3xl">{profile.headline}</h1>
        <p class="mt-2 text-lg text-muted">{profile.role}</p>
        <p class="mt-4 text-muted max-w-2xl">{profile.summary}</p>
        <p class="mt-3 text-sm text-muted">{profile.metaLine}</p>
      </div>
      <Image
        src={headshot}
        alt="Retrato de Alejandro, desarrollador web en Valencia"
        widths={[360, 480, 640, 960]}
        sizes="(min-width: 768px) 300px, calc(100vw - 3rem)"
        width={1152}
        height={1440}
        loading="eager"
        fetchpriority="high"
        class="w-full max-w-sm rounded-lg"
      />
    </div>

    <h2 class="mt-10 text-xl font-bold">Cómo es trabajar conmigo</h2>
    <Grid gap="4" class="mt-4 md:grid-cols-3">
      {
        profile.workWithMe.map((card) => (
          <div class="border border-border rounded-lg p-5 bg-card">
            <strong class="block">{card.title}</strong>
            <p class="text-sm text-muted mt-2">{card.body}</p>
          </div>
        ))
      }
    </Grid>

    <section class="mt-10">
      <h2 class="text-xl font-bold">Con qué tipo de proyectos trabajo</h2>
      <p class="mt-3 text-muted max-w-2xl">
        {profile.trajectory}
        {' '}
        <Link href="/proyectos" variant="inline" class="text-primary">Casos reales</Link>
      </p>
    </section>

    <details class="mt-10 border border-border rounded-lg p-5 bg-card">
      <summary class="font-bold cursor-pointer focus-ring rounded">
        Cómo compruebo la calidad
      </summary>
      <p class="mt-3 text-sm text-muted">
        Reviso velocidad, accesibilidad, seguridad básica y funcionamiento de formularios. También
        realizo pruebas automáticas antes de cada entrega.
      </p>
      <p class="mt-2 text-sm text-muted">{profile.qualityTechnical}</p>
    </details>

    <div class="mt-10">
      <Button href="/contacto">Cuéntame qué necesitas</Button>
    </div>
  </Container>
</Layout>
