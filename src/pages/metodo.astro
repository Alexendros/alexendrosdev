---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { processPage } from '../content/process';

const { seo, hero, steps, close } = processPage;
---

<Layout
  title={seo.title}
  description={seo.description}
  ogImage="/og/proceso-y-entrega.png"
  ogImageAlt="Metodología clara. Desde la idea hasta el producto entregado"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <header>
      <h1 id="delivery-hero-title" class="text-step-3 break-words font-bold max-w-3xl text-balance">
        {hero.h1Lead}<span class="text-primary">{hero.h1Accent}</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
    </header>

    <section id="proceso" class="mt-16" aria-labelledby="delivery-hero-title">
      <div class="grid steps md:grid-cols-2 lg:grid-cols-4 list-none p-0">
        {
          steps.map((step) => (
            <li class="min-w-0 border-t-2 border-primary pt-5">
              <span class="steps-num block font-mono text-sm text-primary" aria-hidden="true" />
              <h2 class="font-bold text-lg mt-2">{step.title}</h2>
              <p class="mt-3 text-sm text-muted">{step.description}</p>
              <p class="mt-4 text-sm">
                <strong>Se recibe:</strong> {step.receive}
              </p>
            </li>
          ))
        }
      </div>
    </section>

    <section class="mt-16 max-w-2xl" aria-labelledby="metodo-close-heading">
      <h2 id="metodo-close-heading" class="text-step-2 font-bold">
        {close.heading}
      </h2>
      <p class="mt-3 text-muted">{close.body}</p>
      <div class="mt-6">
        <Button href={close.href}>{close.heading}</Button>
      </div>
    </section>
  </div>
</Layout>
