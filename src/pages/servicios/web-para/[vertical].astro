---
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/Container.astro';
import Button from '../../../components/Button.astro';
import Link from '../../../components/Link.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import { verticals } from '../../../content/verticals';
import { services } from '../../../content/services';
export async function getStaticPaths() {
  return verticals.map((v) => ({ params: { vertical: v.slug }, props: { vertical: v } }));
}
const { vertical } = Astro.props;
const service = services.find((s) => s.slug === vertical.relatedService);
const pageUrl = new URL(`/servicios/web-para/${vertical.slug}`, 'https://alexendros.dev').href;

const jsonLd = [
  {
    '@type': 'Service',
    name: vertical.title,
    description: vertical.short,
    url: pageUrl,
    serviceType: vertical.title,
    provider: { '@type': 'Organization', name: 'Alexendros', url: 'https://alexendros.dev' },
    areaServed: { '@type': 'City', name: 'Valencia' }
  },
  {
    '@type': 'FAQPage',
    mainEntity: vertical.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer }
    }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://alexendros.dev/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios',
        item: 'https://alexendros.dev/servicios'
      },
      { '@type': 'ListItem', position: 3, name: vertical.name, item: pageUrl }
    ]
  }
];
---

<Layout title={`${vertical.title} — Alexendros`} description={vertical.short} jsonLd={jsonLd}>
  <Container size="narrow" class="py-16 md:py-24">
    <div class="text-xs text-muted">
      <Link href="/servicios" variant="nav">Cómo puedo ayudarte</Link> / {vertical.name}
    </div>
    <h1 class="mt-2 text-4xl font-bold max-w-3xl">{vertical.title}</h1>
    <p class="mt-3 text-muted max-w-2xl">{vertical.intro}</p>

    <div class="mt-10 space-y-10">
      <div>
        <Eyebrow>FIG. 01</Eyebrow>
        <h2 class="text-2xl font-bold mt-2">Problemas habituales</h2>
        <ul class="mt-3 list-disc pl-5 text-sm text-muted space-y-1">
          {vertical.painPoints.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div>
        <Eyebrow>FIG. 02</Eyebrow>
        <h2 class="text-2xl font-bold mt-2">Cómo lo resolvemos</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {
            vertical.solutions.map((s) => (
              <article class="card-lift border border-border rounded-lg p-5 bg-card">
                <h3 class="font-bold">{s.title}</h3>
                <p class="mt-2 text-sm text-muted">{s.description}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <Eyebrow>FIG. 03</Eyebrow>
        <h2 class="text-2xl font-bold mt-2">Preguntas frecuentes</h2>
        <div class="mt-4 space-y-3">
          {
            vertical.faqs.map((f) => (
              <details class="border border-border rounded-lg p-5 bg-card">
                <summary class="font-bold cursor-pointer focus-ring rounded">{f.question}</summary>
                <p class="mt-3 text-sm text-muted">{f.answer}</p>
              </details>
            ))
          }
        </div>
      </div>

      {
        service && (
          <p class="text-sm text-muted">
            Servicio relacionado:{' '}
            <Link href={`/servicios/${service.slug}`} variant="inline">
              {service.title}
            </Link>{' '}
            · {service.pricingFrom} · {service.timeline}
          </p>
        )
      }

      <Button href={vertical.cta}>Cuéntame tu caso</Button>
    </div>
  </Container>
</Layout>
