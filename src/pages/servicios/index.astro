---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import DetailIsland from '../../components/DetailIsland.astro';
import NeedsConfigurator from '../../components/NeedsConfigurator.astro';
import { serviceProducts, services } from '../../content/services';

const detailItems = services.map((s) => ({
  slug: s.slug,
  path: `/servicios/${s.slug}`,
  title: s.title,
  short: s.short,
  description: s.description,
  ctaLabel: s.action.label,
  ctaHref: s.action.href
}));
---

<Layout
  title="Servicios profesionales — Alexendros"
  description="Auditoría técnica SEO, privacidad y accesibilidad, seguridad web, colaboración técnica y sitio profesional por módulos."
  ogImage="/og/servicios.png"
  ogImageAlt="Servicios profesionales de Alexendros.dev"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <header>
      <h1 class="text-step-3 break-words font-bold max-w-3xl text-balance">
        Catálogo de servicios profesionales en{' '}
        <span class="text-primary">respuesta a necesidades reales</span>
      </h1>
      <div class="pagehead-rule mt-4 h-px bg-border" aria-hidden="true"></div>
      <p class="text-muted mt-3 max-w-2xl">
        Revisiones técnicas y colaboración por fases: se define el alcance de cada encargo y se
        entrega un informe o un trabajo acotado, con sus límites por escrito.
      </p>
    </header>
    <p class="mt-4 max-w-2xl text-sm text-muted" data-services-proposal-note>
      El alcance, el calendario y las condiciones económicas se detallan en cada propuesta.
    </p>
    <div class="grid mt-8 md:grid-cols-2">
      {
        serviceProducts.map((product) => (
          <div class="h-full">
            <ServiceCard product={product} />
          </div>
        ))
      }
    </div>
    <DetailIsland basePath="/servicios" items={detailItems} />

    <section class="mt-16" aria-labelledby="portal-heading">
      <NeedsConfigurator />
      <noscript>
        <p class="mt-4 rounded-lg border border-border bg-card p-4 text-sm">
          Sin JavaScript el selector no guarda la selección. Puedes{' '}
          <a
            href="/contacto?motivo=propuestaComercial"
            class="underline decoration-dotted underline-offset-2 text-primary"
          >
            pedir una propuesta
          </a>{' '}
          indicando los módulos de interés.
        </p>
      </noscript>
    </section>
  </div>
</Layout>
