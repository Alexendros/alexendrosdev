---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Link from '../../components/Link.astro';
import { services } from '../../content/services';
import { site } from '../../content/site';

export async function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
// URLs con barra final para coincidir con el canonical de Layout.
const pageUrl = new URL(`/servicios/${service.slug}/`, site.url).href;
const isSoftware = service.slug === 'software-a-medida';
const relatedCase = isSoftware
  ? { href: '/referencias/zedazo', label: 'Saber más sobre Zedazo' }
  : null;
const jsonLd = [
  {
    '@type': 'Service',
    name: service.title,
    description: service.short,
    url: pageUrl,
    serviceType: service.title,
    provider: {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#alexendros`,
      name: site.name,
      url: site.url
    },
    areaServed: { '@type': 'City', name: 'Valencia' }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios profesionales',
        item: new URL('/servicios/', site.url).href
      },
      { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl }
    ]
  }
];
---

<Layout
  title={`${service.title} — Alexendros`}
  description={service.short}
  ogImage={`/og/servicios/${service.slug}.png`}
  ogImageAlt={`Ficha de ${service.title}`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <article data-product-detail={service.slug}>
      <nav class="text-xs text-muted" aria-label="Miga de pan">
        <Link href="/servicios" variant="nav">Servicios profesionales</Link> / {service.title}
      </nav>
      <h1 class="mt-2 text-step-3 break-words font-bold max-w-3xl text-balance">{service.title}</h1>
      <p class="mt-3 text-muted max-w-2xl">{service.short}</p>
      <p class="mt-4 text-sm text-muted max-w-2xl">{service.description}</p>

      <p class="mt-4 text-xs text-muted max-w-2xl" data-product-proposal-note>
        El alcance y las condiciones económicas se detallan en la propuesta individual.
      </p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2 text-sm" data-product-section="commercial">
        <div class="border border-border rounded-lg p-4 bg-card">
          <dt class="text-muted">Plazo</dt>
          <dd class="font-medium mt-1">{service.commercial.timeline}</dd>
        </div>
        <div class="border border-border rounded-lg p-4 bg-card">
          <dt class="text-muted">Entrega</dt>
          <dd class="font-medium mt-1">{service.commercial.delivery}</dd>
        </div>
        <div class="border border-border rounded-lg p-4 bg-card sm:col-span-2">
          <dt class="text-muted">Garantía</dt>
          <dd class="font-medium mt-1">{service.commercial.guarantee}</dd>
        </div>
      </dl>

      <div class="mt-10 space-y-8">
        <section data-product-section="audience">
          <h2 class="text-2xl font-bold">{isSoftware ? 'Para quién' : 'Para quién es'}</h2>
          <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
            {service.audience.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        {
          !isSoftware && (
            <section data-product-section="problems">
              <h2 class="text-2xl font-bold">Qué problema aborda</h2>
              <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
                {service.problems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          !isSoftware && (
            <section data-product-section="scope">
              <h2 class="text-2xl font-bold">Qué incluye</h2>
              <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
                {service.scope.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          isSoftware ? (
            <>
              <section data-product-section="process">
                <h2 class="text-2xl font-bold">Cómo se hace</h2>
                <ol class="mt-2 list-decimal pl-5 text-sm text-muted space-y-1">
                  {service.process.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </section>
              <section data-product-section="deliverables">
                <h2 class="text-2xl font-bold">Qué se entrega</h2>
                <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
                  {service.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            </>
          ) : (
            <>
              <section data-product-section="deliverables">
                <h2 class="text-2xl font-bold">Qué se entrega</h2>
                <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
                  {service.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
              <section data-product-section="process">
                <h2 class="text-2xl font-bold">Cómo se desarrolla</h2>
                <ol class="mt-2 list-decimal pl-5 text-sm text-muted space-y-1">
                  {service.process.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </section>
            </>
          )
        }

        <section data-product-section="exclusions">
          <h2 class="text-2xl font-bold">Qué no incluye</h2>
          <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
            {service.commercial.exclusions.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section data-product-section="requirements">
          <h2 class="text-2xl font-bold">Requisitos del cliente</h2>
          <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
            {service.requirements.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section data-product-section="next-step">
          <h2 class="text-2xl font-bold">Siguiente paso</h2>
          <p class="mt-2 text-sm text-muted max-w-2xl">
            La solicitud se envía desde el formulario con el contexto de este servicio. La respuesta
            llega por el canal indicado.
          </p>
          <div class="mt-4">
            {
              service.action.newTab ? (
                <Button
                  href={service.action.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-product-action="primary"
                >
                  {service.action.label}
                </Button>
              ) : (
                <Button href={service.action.href} data-product-action="primary">
                  {service.action.label}
                </Button>
              )
            }
          </div>
        </section>

        {
          relatedCase && (
            <p class="text-sm">
              <Link href={relatedCase.href} variant="arrow">
                {relatedCase.label}
              </Link>
            </p>
          )
        }

        <section data-product-section="technical">
          <details class="border border-border rounded-lg p-5 bg-card">
            <summary class="font-bold cursor-pointer focus-ring rounded">Detalles técnicos</summary>
            <div class="mt-3 space-y-2 text-sm text-muted">
              {service.technicalDetails.map((t) => <p>{t}</p>)}
            </div>
          </details>
        </section>
      </div>
    </article>
  </div>
</Layout>
