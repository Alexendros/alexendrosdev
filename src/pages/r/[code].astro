---
export const prerender = false;

import { isAllowedReferralCode } from '../../content/referralCodes';
import { normalizeReferralCode, REFERRAL_MAX_AGE_SECONDS } from '../../lib/referral';

const CONTACT_DEST = '/#contacto';
const raw = Astro.params.code ?? '';
const code = normalizeReferralCode(raw);

if (code && isAllowedReferralCode(code)) {
  Astro.cookies.set('alexendros_ref', code, {
    path: '/',
    maxAge: REFERRAL_MAX_AGE_SECONDS,
    sameSite: 'lax',
    httpOnly: true,
    secure: import.meta.env.PROD
  });
}

return Astro.redirect(CONTACT_DEST, 302);
---
