---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Container from '../components/Container.astro';
import Stack from '../components/Stack.astro';

const clauses = [
  {
    title: 'Presupuesto desglosado',
    desc: 'Cada concepto y su coste aparecen por escrito antes de empezar. Sin partidas ocultas.'
  },
  {
    title: 'Pago fraccionado sin recargo',
    desc: 'Desde 990 €, el pago se reparte sin coste de financiación. El calendario queda en el contrato.'
  },
  {
    title: 'Mantenimiento operativo del dominio',
    desc: 'En portales contratados, 12 meses de certificado, publicación y respuesta a una caída en 2 días laborables. Sin cambios de contenido.'
  },
  {
    title: 'Objetivos y resultados comprobables',
    desc: 'Lo acordado se mide: plazos, entregables y umbrales de calidad (LCP, axe, contraste) quedan en el alcance.'
  }
];
---

<Layout
  title="Valores — Alexendros"
  description="Cláusulas contractuales que añaden valor: presupuesto desglosado, pago fraccionado, mantenimiento del dominio y resultados medibles."
>
  <Container size="narrow" class="pt-12 pb-16">
    <PageHead
      kicker="EN DESARROLLO"
      title="Valores"
      description="Cláusulas que diferencian la entrega respecto a ofertas genéricas de internet."
    />

    <p class="mt-6 text-sm text-muted border border-border rounded-lg p-4 bg-card">
      Sección en desarrollo. Estas cláusulas se irán detallando en el contrato de cada encargo.
    </p>

    <Stack as="ul" gap="4" class="mt-10">
      {
        clauses.map((clause, i) => (
          <li
            class="card-lift card-rail border border-border rounded-lg p-5 bg-card"
            data-reveal
            style={`--i:${i}`}
          >
            <h2 class="font-bold">{clause.title}</h2>
            <p class="text-sm text-muted mt-2">{clause.desc}</p>
          </li>
        ))
      }
    </Stack>
  </Container>
</Layout>
