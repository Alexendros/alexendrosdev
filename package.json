{
  "name": "alexendros.dev-astro-mvp",
  "type": "module",
  "version": "1.3.2",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/fix-vercel-runtime.mjs",
    "preview": "serve .vercel/output/static -l 4321 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contract": "vitest run src/lib/contactSchema.test.ts src/lib/smtpConfig.test.ts src/lib/contactHandler.test.ts src/lib/calSignature.test.ts src/lib/calWebhookSchema.test.ts src/lib/calNotionMapper.test.ts src/lib/calWebhookHandler.test.ts",
    "gen:og": "node scripts/gen-og.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "smoke": "bash scripts/smoke.sh",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.2",
    "@astrojs/vercel": "^7.8.2",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@notionhq/client": "^5.26.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^4.16.0",
    "nodemailer": "^6.9.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "uqr": "^0.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.48.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
