SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=operaciones@alexendros.dev
SMTP_PASS=tu_app_password_proton
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
PUBLIC_SITE_URL=https://alexendros.dev

# Cal.com webhook → Notion Leads (POST /api/cal/webhook)
# Secreto del webhook en Cal.com (Settings → Developer → Webhooks). Nunca commitear el valor.
CAL_WEBHOOK_SECRET=cambia_este_secreto
# Token de integración interna de Notion con acceso a Leads / Bookings.
NOTION_TOKEN=secret_xxx
# @notionhq/client v5 (Notion-Version 2025-09-03) requiere el DATA SOURCE id, no el id de la página.
# Página contenedora (solo referencia): 7c26e759d97d4f398b7955944a084b69
# https://app.notion.com/p/7c26e759d97d4f398b7955944a084b69
NOTION_LEADS_DATABASE_ID=84b33eb7-f117-46ad-aedd-120852b5cbb7
# Opcional: mismo valor, gana sobre DATABASE_ID si ambos existen.
# NOTION_LEADS_DATA_SOURCE_ID=84b33eb7-f117-46ad-aedd-120852b5cbb7

# Consentimiento de cookies (CMP vanilla-cookieconsent, Consent Mode v2)
PUBLIC_COOKIE_CONSENT_VERSION=1

# Analítica y marketing. En Fase 1 van vacíos: sin ID los loaders no cargan nada.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_GTM_SS_DOMAIN=
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_LINKEDIN_PARTNER_ID=

# Anti-spam con Cloudflare Turnstile. Si TURNSTILE_SECRET_KEY está definido,
# el API de contacto exige un token válido (PUBLIC_* es la site key pública).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Fase 2 (server-side, no commitear valores reales)
# Meta Conversions API. META_PIXEL_ID cae a PUBLIC_META_PIXEL_ID si está vacío.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de test CAPI para depurar en Events Manager.
META_CAPI_TEST_EVENT_CODE=
